<Page x:Class="MoonHotel.View.OrdersMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="OrdersMenuPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Orders Menu"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 40"/>

            <Button Content="Book Order" Width="260" Height="45" Margin="8"
                    Background="#fdbb2d" Foreground="#1a2a6c"
                    Click="Book_Click"/>

            <Button Content="Food Order" Width="260" Height="45" Margin="8"
                    Background="#fdbb2d" Foreground="#1a2a6c"
                    Click="Food_Click"/>

            <Button Content="Shop Products" Width="260" Height="45" Margin="8"
                    Background="#fdbb2d" Foreground="#1a2a6c"
                    Click="Shop_Click"/>

            <Button Content="Facilities" Width="260" Height="45" Margin="8"
                    Background="#fdbb2d" Foreground="#1a2a6c"
                    Click="Facilities_Click"/>

            <Button Content="Submit Feedback" Width="260" Height="45" Margin="8"
                    Background="#fdbb2d" Foreground="#1a2a6c"
                    Click="Review_Click"/>

            <Button Content="Back To Home" Width="260" Height="45" Margin="8"
                    Background="#fdbb2d" Foreground="#1a2a6c"
                    Click="Back_Click"/>

        </StackPanel>

    </Grid>
</Page>
