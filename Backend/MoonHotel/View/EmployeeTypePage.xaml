<Page x:Class="MoonHotel.View.EmployeeTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EmployeeTypePage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Employee Access"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 40"
                       HorizontalAlignment="Center"/>

            <Button Content="Existing Employee"
                    Width="260"
                    Height="60"
                    Margin="10"
                    FontSize="18"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    BorderThickness="0"
                    Click="Existing_Click"/>

            <Button Content="New Employee"
                    Width="260"
                    Height="60"
                    Margin="10"
                    FontSize="18"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    BorderThickness="0"
                    Click="New_Click"/>

        </StackPanel>

    </Grid>
</Page>
