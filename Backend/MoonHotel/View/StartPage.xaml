<Page x:Class="MoonHotel.View.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      Title="StartPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c" Offset="0"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000" CornerRadius="0"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="MOON HOTEL" 
                       FontSize="72" 
                       FontFamily="Segoe UI Light" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#fdbb2d" ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
            </TextBlock>

            <Separator Width="200" Margin="0,10,0,30" Background="#fdbb2d" Height="2"/>

            <StackPanel Margin="0,0,0,40">
                <TextBlock Text="Developed by:" 
                           Foreground="#fdbb2d" 
                           FontSize="14" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10" 
                           FontWeight="SemiBold"/>

                <TextBlock Text="Atena Sadeghi - 403521462" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="5"/>
                <TextBlock Text="Sarina Abbasi - 403521492" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="5"/>
                <TextBlock Text="Parnya Azimi - 403522019" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="5"/>
            </StackPanel>

            <Button x:Name="btnEnter" 
                    Content="ENTER" 
                    Click="enter" 
                    Width="150" 
                    Height="45" 
                    FontSize="18" 
                    FontWeight="Bold" 
                    Cursor="Hand"
                    Background="#fdbb2d" 
                    Foreground="#1a2a6c"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="22"/>
                    </Style>
                </Button.Resources>
            </Button>

            <TextBlock Text="Spring 1405" 
                       Margin="0,60,0,0" 
                       FontFamily="Consolas" 
                       FontSize="14" 
                       Foreground="#88FFFFFF" 
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Page>
