<Page x:Class="MoonHotel.View.NewCustomerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="NewCustomerPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <ScrollViewer>

            <StackPanel Margin="0 60 0 0" HorizontalAlignment="Center">

                <TextBlock Text="Customer Registration"
                           FontSize="40"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="First Name:" Width="120" Foreground="White"/>
                    <TextBox x:Name="txtFirstName" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="Last Name:" Width="120" Foreground="White"/>
                    <TextBox x:Name="txtLastName" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="National ID:" Width="120" Foreground="White"/>
                    <TextBox x:Name="txtNationalID" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="Birth Date:" Width="120" Foreground="White"/>
                    <DatePicker x:Name="dpBirthDate" Width="200"/>
                </StackPanel>

                <StackPanel x:Name="PhoneStack" Margin="0 20">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Phone Numbers" Width="120" Foreground="White"/>
                        <Button Content="Add Phone"
                                Width="120"
                                Margin="10 0"
                                Click="AddPhone_Click"/>
                    </StackPanel>

                    <TextBox x:Name="txtPhone1" Width="350" Margin="120 10 0 0"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="City:" Width="120" Foreground="White"/>
                    <TextBox x:Name="txtCity" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="Street:" Width="120" Foreground="White"/>
                    <TextBox x:Name="txtStreet" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="Postal Code:" Width="120" Foreground="White"/>
                    <TextBox x:Name="txtPostalCode" Width="350"/>
                </StackPanel>

                <Button Content="Register"
                        Width="200"
                        Height="45"
                        Margin="0 30 0 10"
                        Background="#fdbb2d"
                        Foreground="#1a2a6c"
                        FontWeight="Bold"
                        Click="Register_Click"/>

                <Button Content="Back To Home"
                        Width="200"
                        Height="40"
                        Background="#fdbb2d"
                        Foreground="#1a2a6c"
                        FontWeight="Bold"
                        Click="Back_Click"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Page>
