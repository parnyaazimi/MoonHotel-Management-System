<Page x:Class="MoonHotel.View.ExistingCustomerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ExistingCustomerPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <ScrollViewer>

            <StackPanel Margin="0 120 0 0" HorizontalAlignment="Center">

                <TextBlock Text="Existing Customer"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0 0 0 40"
                           HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="First Name:" Width="120" Foreground="White"/>
                    <TextBox x:Name="CustomerFirstNameBox" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="Last Name:" Width="120" Foreground="White"/>
                    <TextBox x:Name="CustomerLastNameBox" Width="350"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 10">
                    <TextBlock Text="National ID:" Width="120" Foreground="White"/>
                    <TextBox x:Name="NationalIdBox" Width="350"/>
                </StackPanel>

                <Button Content="Open Orders"
                        Width="200"
                        Height="40"
                        Margin="0 30 0 10"
                        Background="#fdbb2d"
                        Foreground="#1a2a6c"
                        FontWeight="Bold"
                        Click="Orders_Click"/>

                <Button Content="Back To Home"
                        Width="200"
                        Height="40"
                        Background="#fdbb2d"
                        Foreground="#1a2a6c"
                        Click="Back_Click"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Page>
