<Page x:Class="MoonHotel.View.ShopProductOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ShopProductOrderPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c" Offset="0"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Shop Order"
                       FontSize="36"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0 0 0 40"
                       HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text="Product Name:"
                           Foreground="White"
                           Width="130"/>

                <TextBox Width="300"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text="Quantity:"
                           Foreground="White"
                           Width="130"/>

                <TextBox Width="150"/>
            </StackPanel>

            <Button Content="Back To Home"
                    Width="200"
                    Height="40"
                    Margin="0 30 0 0"
                    Click="Back_Click"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"/>

        </StackPanel>

    </Grid>
</Page>
