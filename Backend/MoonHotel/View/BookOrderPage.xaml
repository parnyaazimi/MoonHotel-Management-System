<Page x:Class="MoonHotel.View.BookOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BookOrderPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Book Order"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 40"
                       HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBlock Text="Book Name:" Width="120" Foreground="White"/>
                <TextBox Width="350"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBlock Text="Author Name:" Width="120" Foreground="White"/>
                <TextBox Width="350"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBlock Text="Quantity:" Width="120" Foreground="White"/>
                <TextBox Width="200"/>
            </StackPanel>

            <Button Content="Back To Home"
                    Width="200"
                    Height="40"
                    Margin="0 30 0 0"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    Click="Back_Click"/>

        </StackPanel>

    </Grid>
</Page>
