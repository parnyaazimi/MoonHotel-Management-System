<Page x:Class="MoonHotel.View.ReservationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ReservationPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="New Reservation"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 40"/>

            <StackPanel Orientation="Horizontal" Margin="0 8">
                <TextBlock Text="Hotel:" Width="130" Foreground="White"/>
                <ComboBox x:Name="cmbHotel"
              Width="200"
              DisplayMemberPath="HotelName"
              SelectedValuePath="HotelID"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 8">
                <TextBlock Text="Room Number:" Width="130" Foreground="White"/>
                <TextBox x:Name="txtRoomNumber" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 8">
                <TextBlock Text="Guests Count:" Width="130" Foreground="White"/>
                <TextBox x:Name="txtGuests" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 8">
                <TextBlock Text="Check-In Date:" Width="130" Foreground="White"/>
                <DatePicker x:Name="dpCheckIn" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 8">
                <TextBlock Text="Check-Out Date:" Width="130" Foreground="White"/>
                <DatePicker x:Name="dpCheckOut" Width="200"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 25 0 0">
                <Button Content="Confirm Reservation"
                        Width="180" Height="45"
                        Margin="0 0 15 0"
                        Background="#fdbb2d"
                        Foreground="#1a2a6c"
                        Click="Confirm_Click"/>

                <Button Content="Back"
                        Width="120" Height="45"
                        Background="#fdbb2d"
                        Foreground="#1a2a6c"
                        Click="Back_Click"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Page>
