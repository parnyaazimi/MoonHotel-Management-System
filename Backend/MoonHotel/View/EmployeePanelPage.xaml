<Page x:Class="MoonHotel.View.EmployeePanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="EmployeePanelPage">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a2a6c" Offset="0"/>
                <GradientStop Color="#b21f1f" Offset="0.5"/>
                <GradientStop Color="#fdbb2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#AA000000"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Employee Panel"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 40"
                       HorizontalAlignment="Center"/>

            <Button Content="Manage Books"
                    Width="260"
                    Height="50"
                    Margin="10"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="ManageBooks_Click"/>

            <Button Content="Manage Foods"
                    Width="260"
                    Height="50"
                    Margin="10"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="ManageFoods_Click"/>

            <Button Content="Manage Shop Products"
                    Width="260"
                    Height="50"
                    Margin="10"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="ManageShop_Click"/>

            <Button Content="Manage Facilities"
                    Width="260"
                    Height="50"
                    Margin="10"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="ManageFacilities_Click"/>

            <Button Content="Manage Rooms"
                    Width="260"
                    Height="50"
                    Margin="10"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="ManageRooms_Click"/>

            <Button Content="Back To Home"
                    Width="260"
                    Height="45"
                    Margin="20"
                    Background="#fdbb2d"
                    Foreground="#1a2a6c"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Back_Click"/>

        </StackPanel>

    </Grid>
</Page>
