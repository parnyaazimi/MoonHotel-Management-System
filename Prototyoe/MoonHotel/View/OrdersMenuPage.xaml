<Page x:Class="MoonHotel.View.OrdersMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersMenuPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Button Content="Book Order" Width="250" Height="50" Margin="10" Click="Book_Click"/>
                <Button Content="Food Order" Width="250" Height="50" Margin="10" Click="Food_Click"/>
                <Button Content="Shop Products" Width="250" Height="50" Margin="10" Click="Shop_Click"/>
                <Button Content="Facilities" Width="250" Height="50" Margin="10" Click="Facilities_Click"/>
                <Button Content="Submit Feedback" Width="250" Height="50" Margin="10" Click="Review_Click"/>

                <Button Content="Back To Home" Width="250" Height="50" Margin="10" Click="Back_Click"/>

            </StackPanel>

    </Grid>
</Page>
