<Page x:Class="MoonHotel.View.ManageShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ManageShopPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Manage Shop Products" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="Add Product" Width="250" Height="50" Margin="10"/>
            <Button Content="Inventory Report" Width="250" Height="50" Margin="10"/>
            <Button Content="Back to Home" Width="250" Height="50" Margin="10" Click="BackToPanel_Click"/>
        </StackPanel>
    </Grid>
</Page>