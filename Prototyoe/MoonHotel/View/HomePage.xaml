<Page x:Class="MoonHotel.View.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >

            <Button Content="Customer" Width="200" Height="80" Margin="20" Click="Customer_Click"/>
            <Button Content="Employee" Width="200" Height="80" Margin="20" Click="Employee_Click"/>

        </StackPanel>
    </Grid>
</Page>
