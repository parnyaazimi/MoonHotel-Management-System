<Page x:Class="MoonHotel.View.ManageBooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ManageBooksPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Manage Books" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="Add New Book" Width="250" Height="50" Margin="10"/>
            <Button Content="View All Books" Width="250" Height="50" Margin="10"/>
            <Button Content="Back to Home" Width="250" Height="50" Margin="10" Click="BackToPanel_Click"/>
        </StackPanel>
    </Grid>
</Page>