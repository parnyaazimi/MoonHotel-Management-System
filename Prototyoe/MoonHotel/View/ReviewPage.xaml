<Page x:Class="MoonHotel.View.ReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReviewPage">

    <Grid>
        <StackPanel Margin="0 20 0 0">
            <StackPanel Orientation="Horizontal" Margin="20">
                
                <TextBlock Text="Review:" Margin="100 0 45 5"/>
                <TextBox Width="400" Height="150" AcceptsReturn="True"/>
            
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="20">
                <TextBlock Text="Rating (1-5):" Margin="100 5 0 5"/>

                <ComboBox Width="100" Margin="20 0 0 0" Height="25">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                </ComboBox>
                
            </StackPanel>

            <Button Content="Back To Home" Width="200" Margin="0 30 0 0" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>
