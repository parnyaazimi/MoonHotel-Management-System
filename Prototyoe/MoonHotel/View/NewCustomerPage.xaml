<Page x:Class="MoonHotel.View.NewCustomerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewCustomerPage">

    <ScrollViewer>

        <StackPanel Margin="0 50 0 0">

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="First Name:" Margin="0 0 50 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Last Name:" Margin="0 0 50 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="National ID:" Margin="0 0 50 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Birth Date:" Margin="0 0 55 0"/>
                <DatePicker Width="200"/>
            </StackPanel>


            <StackPanel x:Name="PhoneStack" Orientation="Horizontal">

                <TextBlock Text="Phone Numbers" Margin="150 20 0 0"/>
                <Button Content="Add Phone Number" Width="200" Margin="150 10 0 0" Click="AddPhone_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 20 0 0">
                <TextBlock Text="City:" Margin="0 0 95 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Street:" Margin="0 0 85 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Postal Code:" Margin="0 0 55 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <Button Content="Go To Reservation" Width="200" Margin="150 30 0 0" Click="Reservation_Click"/>

            <Button Content="Back To Home" Width="200" Margin="150 10 0 0" Click="Back_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>

