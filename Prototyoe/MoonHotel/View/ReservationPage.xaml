<Page x:Class="MoonHotel.View.ReservationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReservationPage">

    <Grid>
        
        <StackPanel Margin="10 120 10 10">

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Room Type:" Margin="0 0 70 0"/>
                <ComboBox Width="200">
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="VIP"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Room Capacity:" Margin="0 0 50 0"/>
                <TextBox Width="200"/>
            </StackPanel>

            <Button Content="Back To Home" Width="200" Margin="-10 30 0 0" Click="Back_Click"/>

        </StackPanel>
    </Grid>

</Page>

