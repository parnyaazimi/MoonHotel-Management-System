<Page x:Class="MoonHotel.View.FoodOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FoodOrderPage">

    <Grid>
        <StackPanel Margin="0 150 0 0">

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Food Name:" Margin="0 0 50 0"/>
                <TextBox Width="400"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Category:" Margin="0 0 65 0"/>
                <ComboBox Width="200">
                    <ComboBoxItem Content="Drink"/>
                    <ComboBoxItem Content="Main Course"/>
                    <ComboBoxItem Content="Appetizer"/>
                    <ComboBoxItem Content="Dessert"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                <TextBlock Text="Provider Section:" Margin="0 0 28 0"/>
                <ComboBox Width="200">
                    <ComboBoxItem Content="Restaurant"/>
                    <ComboBoxItem Content="Cafe"/>
                </ComboBox>
            </StackPanel>

            <Button Content="Back To Home" Width="200" Margin="50 30 0 0" Click="Back_Click"/>

        </StackPanel>
    </Grid>
</Page>
