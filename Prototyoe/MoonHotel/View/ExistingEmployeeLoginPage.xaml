<Page x:Class="MoonHotel.View.ExistingEmployeeLoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExistingEmployeeLoginPage">

    <Grid>
        <StackPanel Margin="0 150 0 0">

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="Username:" Margin="0 0 50 0"/>
                    <TextBox Width="300"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="Password:" Margin="0 0 55 0"/>
                    <PasswordBox Width="300"/>
                </StackPanel>

                <Button Content="Login" Width="200" Margin="30 20 0 0" Click="Login_Click"/>

                <Button Content="Back To Home" Width="200" Margin="30 10 0 0" Click="Back_Click"/>

            </StackPanel>

    </Grid>
</Page>
