<Page x:Class="MoonHotel.View.FacilitiesOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FacilitiesOrderPage">

    <Grid>

            <StackPanel Margin="0 150 0 0">

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="Facility:" Margin="0 0 66 0"/>
                    <ComboBox Width="200">
                        <ComboBoxItem Content="Swimming Pool"/>
                        <ComboBoxItem Content="Gym"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="Start Time:" Margin="0 0 50 0"/>
                    <TextBox Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="End Time:" Margin="0 0 55 0"/>
                    <TextBox Width="200"/>
                </StackPanel>

                <Button Content="Back To Home" Width="200" Margin="50 30 0 0" Click="Back_Click"/>

            </StackPanel>

    </Grid>
</Page>
