<Page x:Class="MoonHotel.View.ExistingCustomerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ExistingCustomerPage">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="10 100 10 10">

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="First Name:" Margin="0 0 48 0"/>
                    <TextBox x:Name="CustomerFirstNameBox" Width="400"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="Last Name:" Margin="0 0 50 0"/>
                    <TextBox x:Name="CustomerLastNameBox" Width="400"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="150 10 0 0">
                    <TextBlock Text="National ID:" Margin="0 0 45 0"/>
                    <TextBox x:Name="NationalIdBox" Width="400"/>
                </StackPanel>

                <Button Content="Open Orders" Width="150" Height="30" Margin="150 30 0 0" Click="Orders_Click"/>
                <Button Content="Back To Home" Width="150" Height="30" Margin="150 10 0 0" Click="Back_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

