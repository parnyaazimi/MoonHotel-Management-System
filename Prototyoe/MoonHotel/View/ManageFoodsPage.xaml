<Page x:Class="MoonHotel.View.ManageFoodsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ManageFoodsPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Manage Foods" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="Add Food to Menu" Width="250" Height="50" Margin="10"/>
            <Button Content="Update Prices" Width="250" Height="50" Margin="10"/>
            <Button Content="Back to Home" Width="250" Height="50" Margin="10" Click="BackToPanel_Click"/>
        </StackPanel>
    </Grid>
</Page>