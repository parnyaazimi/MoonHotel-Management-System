<Page x:Class="MoonHotel.View.ManageRoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ManageRoomsPage">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Manage Hotel Rooms" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="Room Status List" Width="250" Height="50" Margin="10"/>
            <Button Content="Add New Room" Width="250" Height="50" Margin="10"/>
            <Button Content="Back to Home" Width="250" Height="50" Margin="10" Click="BackToPanel_Click"/>
        </StackPanel>
    </Grid>
</Page>