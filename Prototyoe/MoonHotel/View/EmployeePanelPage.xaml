<Page x:Class="MoonHotel.View.EmployeePanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoonHotel.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeePanelPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Manage Books" Width="250" Height="50" Margin="10"/>
            <Button Content="Manage Foods" Width="250" Height="50" Margin="10"/>
            <Button Content="Manage Shop Products" Width="250" Height="50" Margin="10"/>
            <Button Content="Manage Facilities" Width="250" Height="50" Margin="10"/>
            <Button Content="Manage Rooms" Width="250" Height="50" Margin="10"/>
            
            <Button Content="Back To Home" Width="250" Height="50" Margin="10" Click="Back_Click"/>
        </StackPanel>

    </Grid>
</Page>
